						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Offshore Server Credentials\",\n    \"content\": \"IP: 198.51.100.42\\nUsername: admin\\nPrivate Key: encrypted_and_safe\"\n}",
